{
  "manifest_version": 3,
  "name": "CyberShield AI Security",
  "version": "2.1.0",
  "description": "Real-time AI-powered web security monitoring and phishing detection.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CyberShield AI Security",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "config/config.js",
      "utils/browser-compat.js",
      "utils/error-handler.js",
      "background/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cybershield-security@cybershield.io",
      "strict_min_version": "109.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
