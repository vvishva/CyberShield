{
  "manifest_version": 3,
  "name": "CyberShield AI Security",
  "version": "2.0.0",
  "description": "Automatic website threat detection. Warns you about phishing, malware, and suspicious sites as you browse.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://cybershield-backend-uhwn.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberShield AI Security",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
